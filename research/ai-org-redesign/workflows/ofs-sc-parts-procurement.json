{
  "schema_version": "0.3",
  "id": "ofs-sc-parts-procurement",
  "name": "Buy parts and materials",
  "org": "oilfield-services-co",
  "process": "sc-parts-procurement",
  "sector": "oil and gas services",
  "function": "supply chain",
  "summary": "Frac pumps, blenders and coiled tubing units wear out valves, seats, packing and fluid ends in hours of pumping, so the maintenance shops raise a steady stream of parts requisitions, and stock reorder points add more. Buyers check each requisition, look for stock at other bases, place purchase orders against supply agreements or after quotes, get promise dates and chase long-lead items, and warehouse staff receive the goods. Most orders are routine distributor items that arrive within days, but fluid ends, engines, transmissions and tubing strings can take months in an upturn such as 2021-2022, and units sit in the shop waiting for them.",
  "baseline": {
    "period": "2019-2022",
    "org_archetype": "A TSX-listed Canadian pressure pumper with about 1,350 employees, six to eight 24-hour frac crews, a 70-person supply chain department in Calgary and at district bases, an ERP with procurement and inventory, and spreadsheets, email and phone for day-to-day logistics.",
    "org_size_employees": 1350,
    "notes": "ERP with plant maintenance creates requisitions from work orders and reorder points; purchase orders go to suppliers by email."
  },
  "currency": "CAD",
  "unit_of_work": "one purchase order (or requisition filled by transfer)",
  "trigger": "A maintenance work order needs a part, a stock item falls below its reorder point, or a coiled tubing string or upgrade project needs material.",
  "end_state": "The part is received and the receipt matched for payment, or the requisition is filled from another base or cancelled.",
  "cadence": "per_case",
  "volume": {
    "cases_per_month": {
      "low": 800,
      "mode": 1200,
      "high": 1800
    },
    "seasonality": "Highest during spring break-up when fleets are parked for maintenance and before the winter season; 2020 far below the low end; 2021-2022 high with reactivations.",
    "evidence": {
      "tier": "C",
      "sources": [],
      "note": "Organisation file estimate tied to about 14,000 equipment hours a month; not checked against a source."
    },
    "surge": {
      "cause": "Spring break-up maintenance and rebuild season while road bans park the fleets (April to early June)",
      "events_per_year": {
        "low": 1,
        "mode": 1,
        "high": 1
      },
      "duration_days": {
        "low": 45,
        "mode": 60,
        "high": 75
      },
      "volume_multiplier": {
        "low": 1.15,
        "mode": 1.35,
        "high": 1.6
      },
      "evidence": {
        "tier": "B",
        "sources": [
          "step_2021"
        ],
        "note": "Spring break-up restricts equipment moves (step_2021); the organisation file treats break-up as a maintenance surge. Multiplier is the author's estimate."
      }
    }
  },
