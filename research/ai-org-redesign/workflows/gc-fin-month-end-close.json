{
  "schema_version": "0.3",
  "id": "gc-fin-month-end-close",
  "name": "Close the books each month",
  "org": "general-contractor-co",
  "process": "fin-month-end-close",
  "sector": "construction (non-residential general contracting)",
  "function": "finance (accounting)",
  "summary": "Every month finance closes the books for about 220 projects. AP and payroll are cut off, costs not yet invoiced are accrued, and project managers send updated cost-to-complete forecasts. Project accountants then turn those forecasts into percent-complete revenue on the work-in-progress schedule, regional finance and operations leaders review project margins, and the controller and CFO sign off the consolidated results. The close is slow because it waits on project managers' forecasts and review meetings, and the judgments about forecast costs and unapproved change orders drive most of the corrections.",
  "baseline": {
    "period": "2019-2022",
    "org_archetype": "A TSX-listed Canadian general contractor with about $1.5 billion revenue, three regions and about 220 active projects, using a construction ERP and Excel WIP schedules.",
    "org_size_employees": 2800,
    "notes": "One case is one monthly close, from month end to locked period and distributed reports."
  },
  "currency": "CAD",
  "unit_of_work": "one monthly close",
  "trigger": "The calendar month ends.",
  "end_state": "The period is locked, the operations report and job cost reports are distributed, and at quarter end the supporting schedules go to quarterly reporting.",
  "cadence": "monthly",
  "volume": {
    "cases_per_month": {
      "low": 1,
      "mode": 1,
      "high": 1
    },
    "seasonality": "Quarter-end closes carry extra schedules; the December close feeds the annual audit and takes longer.",
    "evidence": {
      "tier": "C",
      "sources": [],
      "note": "One close a month by definition."
    }
  },
