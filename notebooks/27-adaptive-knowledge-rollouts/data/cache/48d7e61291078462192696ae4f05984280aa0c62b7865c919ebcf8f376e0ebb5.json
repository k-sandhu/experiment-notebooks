it-I003\\\",\\\"hold-I011\\\",\\\"NET2026-09-01\\\",\\\"I012\\\",\\\"CAD2026-10-12\\\",\\\"hold-I015\\\",\\\"I011\\\",\\\"payment-I010\\\",\\\"EUR2026-09-01\\\",\\\"credit-I009\\\",\\\"EUR2026-10-12\\\",\\\"payment-I014\\\",\\\"payment-I007\\\",\\\"I016\\\",\\\"hold-I000\\\",\\\"payment-I012\\\",\\\"credit-I002\\\",\\\"payment-I006\\\",\\\"credit-I010\\\",\\\"hold-I014\\\",\\\"CAD2026-09-01\\\",\\\"payment-I011\\\",\\\"USD2026-10-12\\\",\\\"I004\\\",\\\"payment-I003\\\",\\\"credit-I007\\\",\\\"hold-I007\\\",\\\"hold-I010\\\"],\\\"invoice_id\\\": [\\\"\\\",\\\"I004\\\",\\\"I002\\\",\\\"I005\\\",\\\"I016\\\",\\\"I001\\\",\\\"I015\\\",\\\"I014\\\",\\\"I009\\\",\\\"I017\\\",\\\"I008\\\",\\\"I013\\\",\\\"I011\\\",\\\"I006\\\",\\\"I003\\\",\\\"I000\\\",\\\"I012\\\",\\\"I010\\\",\\\"I007\\\"],\\\"vendor\\\": [\\\"BLUE\\\",\\\"\\\",\\\"OTHER\\\"],\\\"recorded_at\\\": [\\\"2026-10-23T10:00:00\\\",\\\"2026-10-24T13:00:00\\\",\\\"2026-10-24T12:00:01\\\"],\\\"status\\\": [\\\"active\\\",\\\"void\\\"],\\\"currency\\\": [\\\"EUR\\\",\\\"CAD\\\",\\\"USD\\\",\\\"\\\"],\\\"terms_code\\\": [\\\"NET\\\",\\\"\\\",\\\"FAST\\\"]}}\"}"
