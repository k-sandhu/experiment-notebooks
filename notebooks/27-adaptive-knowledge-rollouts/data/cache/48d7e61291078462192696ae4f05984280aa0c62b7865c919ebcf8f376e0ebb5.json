        "content": "{\"tool\":\"sql_query\",\"arguments\":{\"company_name\":\"CLOSE_fin_02\",\"table_name\":\"ledger\",\"query\":\"WITH ranked AS (SELECT kind,event_key,invoice_id,vendor,business_date,status,amount_minor,currency,due_date,discount_until,terms_code,discount_bps,fx_num,fx_den,ROW_NUMBER() OVER (PARTITION BY kind,event_key ORDER BY revision DESC) AS rn FROM ledger WHERE business_date <= '2026-10-23' AND recorded_at <= '2026-10-24T12:00:00'), active AS (SELECT kind,event_key,invoice_id,vendor,business_date,status,amount_minor,currency,due_date,discount_until,terms_code,discount_bps,fx_num,fx_den FROM ranked WHERE rn=1 AND status='active'), amounts AS (SELECT i.event_key,i.business_date,i.currency,i.terms_code,i.discount_until,i.amount_minor-COALESCE((SELECT SUM(a.amount_minor) FROM active a WHERE a.kind IN ('payment','credit') AND a.invoice_id=i.event_key AND a.currency=i.currency),0) AS balance,COALESCE((SELECT SUM(h.amount_minor) FROM active h WHERE h.kind='hold' AND h.invoice_id=i.event_key AND h.currency=i.currency),0) AS held FROM active i WHERE i.kind='invoice' AND i.vendor='BLUE' AND i.due_date <= '2026-10-30'), valued AS (SELECT a.event_key,CASE WHEN a.balance <= 0 THEN 0 WHEN a.balance <= a.held THEN 0 ELSE a.balance-a.held END AS unheld,CASE WHEN a.discount_until >= '2026-10-23' THEN 10000-t.discount_bps ELSE 10000 END AS discount_factor,f.fx_num,f.fx_den FROM amounts a JOIN active t ON t.kind='terms' AND t.terms_code=a.terms_code AND t.business_date=(SELECT MAX(t2.business_date) FROM active t2 WHERE t2.kind='terms' AND t2.terms_code=a.terms_code AND t2.business_date <= a.business_date) JOIN active f ON f.kind='fx' AND f.currency=a.currency AND f.business_date=(SELECT MAX(f2.business_date) FROM active f2 WHERE f2.kind='fx' AND f2.currency=a.currency AND f2.business_date <= a.business_date)), rounded AS (SELECT event_key,unheld,discount_factor,fx_num,fx_den,CAST((2*unheld*discount_factor*fx_num+10000*fx_den)/(2*10000*fx_den) AS INTEGER) AS usd_cents FROM valued WHERE fx_den>0) SELECT event_key,unheld,discount_factor,fx_num,fx_den,usd_cents,SUM(usd_cents) OVER () AS total_usd_cents FROM rounded WHERE unheld>=0 ORDER BY event_key\"}}"
