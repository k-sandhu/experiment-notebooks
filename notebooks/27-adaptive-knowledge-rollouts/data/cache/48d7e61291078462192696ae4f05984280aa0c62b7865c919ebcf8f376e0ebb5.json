      {
        "role": "assistant",
        "content": "{\"tool\":\"sql_query\",\"arguments\":{\"company_name\":\"CLOSE_fin_02\",\"table_name\":\"ledger\",\"query\":\"WITH ranked AS (SELECT kind,event_key,invoice_id,vendor,business_date,revision,status,amount_minor,currency,due_date,discount_until,terms_code,discount_bps,fx_num,fx_den,ROW_NUMBER() OVER (PARTITION BY kind,event_key ORDER BY revision DESC) AS rn FROM ledger WHERE business_date <= '2026-10-23' AND recorded_at <= '2026-10-24T12:00:00'), active AS (SELECT kind,event_key,invoice_id,vendor,business_date,status,amount_minor,currency,due_date,discount_until,terms_code,discount_bps,fx_num,fx_den FROM ranked WHERE rn=1 AND status <> 'void') SELECT kind,event_key,invoice_id,vendor,business_date,status,amount_minor,currency,due_date,discount_until,terms_code,discount_bps,fx_num,fx_den FROM active WHERE kind IN ('terms','fx') OR (kind='invoice' AND vendor='BLUE' AND due_date <= '2026-10-30') OR kind IN ('payment','credit','hold') ORDER BY kind,event_key\"} }"
