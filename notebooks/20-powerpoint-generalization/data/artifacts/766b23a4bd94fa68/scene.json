          "h": 3.4,
          "items": [
            {
              "title": "✕ On-hand alone",
              "body": "Do not compare on-hand alone with the trigger. Always use on-hand + on-order − committed."
            },
            {
              "title": "✕ Safety × lead time",
              "body": "Do not multiply safety stock by lead time. Multiply only daily demand by days; add safety stock once."
            },
            {
              "title": "✕ Trigger = quantity",
              "body": "A larger reorder point is a trigger, not the order quantity. Quantity = target position − current position."
            }
