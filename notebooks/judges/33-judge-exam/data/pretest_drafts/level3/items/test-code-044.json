      "text": "def solve(rows):\n    filtered_rows = []\n    for i, row in enumerate(rows):\n        if i % 5 != 4 or i == len(rows) - 1:\n            filtered_rows.append(row)\n\n    if not filtered_rows:\n        return [0, None]\n\n    rotated_rows = filtered_rows\n    n = len(rotated_rows)\n    if n > 0:\n        rotated_rows = rotated_rows[3 % n:] + rotated_rows[:3 % n]\n    \n    total_quantity = 0\n    earliest_expiry = None\n\n    for row in rotated_rows:\n        expiry, quantity = row\n        if expiry > 12:\n            total_quantity += quantity\n            if earliest_expiry is None or expiry < earliest_expiry:\n                earliest_expiry = expiry\n\n    return [total_quantity, earliest_expiry]",
