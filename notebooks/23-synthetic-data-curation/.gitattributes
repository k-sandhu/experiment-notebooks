# Frozen source snapshots and the original contract retain their EOF whitespace.
data/high_v4*/source_snapshot/** whitespace=-blank-at-eof
data/high_v4/fixture_contract.md whitespace=-blank-at-eof

# These six recorded review files use CRLF. Their saved hashes cover exact bytes.
data/high_v4/main_source_review.json -text whitespace=cr-at-eol,-blank-at-eof
data/high_v4/main_source_review.md -text whitespace=cr-at-eol,-blank-at-eof
data/high_v4/source_snapshot/audit_high_failure_materials.py -text whitespace=cr-at-eol,-blank-at-eof
data/high_v4/source_snapshot/audit_high_nonround_errors.py -text whitespace=cr-at-eol,-blank-at-eof
data/high_v4/source_snapshot/high_main_source_review.json -text whitespace=cr-at-eol,-blank-at-eof
data/high_v4/source_snapshot/high_main_source_review.md -text whitespace=cr-at-eol,-blank-at-eof

# V5 keeps complete compressed evidence and byte-frozen source snapshots.
data/scale_v5/**/*.gz binary
data/scale_v5/source_snapshot/** -text whitespace=cr-at-eol,-blank-at-eof
data/scale_v5/** -text whitespace=cr-at-eol,-blank-at-eof
