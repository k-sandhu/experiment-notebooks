  "reply": "```javascript\n'use strict';\n\nconst fs = require('fs');\nconst input = fs.readFileSync(process.argv[2]);\nlet pos = 0;\n\nfunction readInt() {\n  while (pos < input.length && input[pos] <= 32) pos++;\n  let value = 0;\n  while (pos < input.length) {\n    const ch = input[pos];\n    if (ch < 48 || ch > 57) break;\n    value = value * 10 + ch - 48;\n    pos++;\n  }\n  return value;\n}\n\nconst H = readInt();\nconst W = readInt();\nconst S = readInt();\n\nconst stride = W + 2;\nconst size = (H + 2) * stride;\nlet current = new Int32Array(size);\nlet next = new Int32Array(size);\ncurrent.fill(-1);\nnext.fill(-1);\n\nconst cells = new Uint32Array(H * W);\nlet count = 0;\n\nfor (let r = 0; r < H; r++) {\n  while (pos < input.length && input[pos] <= 32) pos++;\n  let index = (r + 1) * stride + 1;\n  for (let c = 0; c < W; c++, index++, pos++) {\n    const ch = input[pos];\n    if (ch === 46) {\n      current[index] = 0;\n      next[index] = 0;\n      cells[count++] = index;\n    } else if (ch !== 35) {\n      const value = (ch - 48) * 1000;\n      current[index] = value;\n      next[index] = value;\n    }\n  }\n}\n\nconst up = new Uint32Array(count);\nconst down = new Uint32Array(count);\nconst left = new Uint32Array(count);\nconst right = new Uint32Array(count);\n\nfor (let j = 0; j < count; j++) {\n  const i = cells[j];\n  up[j] = current[i - stride] < 0 ? i : i - stride;\n  down[j] = current[i + stride] < 0 ? i : i + stride;\n  left[j] = current[i - 1] < 0 ? i : i - 1;\n  right[j] = current[i + 1] < 0 ? i : i + 1;\n}\n\nfor (let step = 0; step < S; step++) {\n  let changed = 0;\n  for (let j = 0; j < count; j++) {\n    const i = cells[j];\n    const old = current[i];\n    const value = (\n      4 * old +\n      current[up[j]] +\n      current[down[j]] +\n      current[left[j]] +\n      current[right[j]]\n    ) >> 3;\n    next[i] = value;\n    changed |= old ^ value;\n  }\n\n  const temp = current;\n  current = next;\n  next = temp;\n  if (changed === 0) break;\n}\n\nlet sum = 0;\nlet max = -1;\nlet maxRow = 0;\nlet maxCol = 0;\nlet checksum = 0n;\nlet checksumPart = 0;\n\nfor (let j = 0; j < count; j++) {\n  const i = cells[j];\n  const value = current[i];\n  const row = Math.floor(i / stride) - 1;\n  const col = i % stride - 1;\n\n  sum += value;\n  if (value > max) {\n    max = value;\n    maxRow = row;\n    maxCol = col;\n  }\n\n  checksumPart += value * (row * W + col + 1);\n  if (checksumPart >= 281474976710656) {\n    checksum += BigInt(checksumPart);\n    checksumPart = 0;\n  }\n}\n\nchecksum += BigInt(checksumPart);\n\nprocess.stdout.write(\n  `sum ${sum}\\nmax ${max} ${maxRow} ${maxCol}\\nchecksum ${checksum}\\n`\n);\n```",
